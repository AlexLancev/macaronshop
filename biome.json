{
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"attributePosition": "multiline",
		"indentStyle": "tab",
		"lineWidth": 80,
		"lineEnding": "crlf"
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noAriaUnsupportedElements": "warn",
				"useAltText": "warn",
				"useAriaPropsForRole": "warn",
				"useValidAriaProps": "warn",
				"useValidAriaValues": "warn"
			},
			"complexity": {
				"noBannedTypes": "error",
				"noUselessTypeConstraint": "error"
			},
			"correctness": {
				"noChildrenProp": "error",
				"noPrecisionLoss": "error",
				"noUnusedVariables": "warn",
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "error",
				"useJsxKeyInIterable": "error",
				"noUnusedImports": "warn"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {}
				}
			},
			"security": {
				"noDangerouslySetInnerHtmlWithChildren": "error",
				"noBlankTarget": "error"
			},
			"style": {
				"noNamespace": "error",
				"useAsConstAssertion": "error",
				"useArrayLiterals": "warn",
				"useImportType": "warn"
			},
			"suspicious": {
				"noCommentText": "error",
				"noDuplicateJsxProps": "error",
				"noExplicitAny": "error",
				"noExtraNonNullAssertion": "error",
				"noMisleadingInstantiator": "error",
				"noUnsafeDeclarationMerging": "error"
			}
		}
	},
	"files": {
		"includes": ["**/*.{ts,tsx}"]
	},
	"overrides": [
		{
			"includes": ["**/*.{ts,tsx}"]
		},
		{
			"includes": ["*.ts", "*.tsx", "*.mts", "*.cts"],
			"linter": {
				"rules": {
					"correctness": {
						"noConstAssign": "off",
						"noGlobalObjectCalls": "off",
						"noInvalidConstructorSuper": "off",
						"noSetterReturn": "off",
						"noUndeclaredVariables": "off",
						"noUnreachable": "off",
						"noUnreachableSuper": "off"
					},
					"style": {
						"useConst": "error"
					},
					"complexity": {
						"noArguments": "error"
					},
					"suspicious": {
						"noDuplicateClassMembers": "off",
						"noDuplicateObjectKeys": "off",
						"noDuplicateParameters": "off",
						"noFunctionAssign": "off",
						"noImportAssign": "off",
						"noRedeclare": "off",
						"noUnsafeNegation": "off",
						"useGetterReturn": "off",
						"noVar": "error"
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":PACKAGE:",
							":BLANK_LINE:",
							["@/types/**"],
							":BLANK_LINE:",
							["@/constants/**", "@/schema/**"],
							":BLANK_LINE:",
							["@/utils/**", "@/lib/**"],
							":BLANK_LINE:",
							["@/data/**"],
							":BLANK_LINE:",
							["@/hooks/**", "@/stores/**"],
							":BLANK_LINE:",
							["@/providers/**"],
							":BLANK_LINE:",
							["@/components/**"],
							":BLANK_LINE:",
							["@/pages/**"],
							":BLANK_LINE:",
							["@/paths/**"],
							":BLANK_LINE:",
							{
								"type": true
							},
							":BLANK_LINE:",
							["./**"]
						]
					}
				}
			}
		}
	}
}
